rules_version = '2';

// ============================================================
// Switchframe — Firestore Security Rules
// ------------------------------------------------------------
// Core principles:
//   1. Nobody who is not signed in can read or write ANYTHING.
//   2. Managers can do everything.
//   3. Workers (including the shared floor account) can do their
//      station work — read everything, update units, post issues,
//      acknowledge announcements — but CANNOT delete units or
//      change settings (config, goals, station lists, user roles).
//
// Role is stored at users/{email}:  { role: "worker" | (manager) }
// A user is a "worker" only if their users doc says role == "worker".
// Anyone else who is signed in is treated as a manager (matches the app).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null;
    }

    // The user's role doc lives at users/{their-email}, lowercased.
    function myRoleDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    function isWorker() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
        && myRoleDoc().role == 'worker';
    }

    // Manager = signed in AND not a worker.
    function isManager() {
      return signedIn() && !isWorker();
    }

    // ---- units ----
    // Everyone signed in can read.
    // Workers may create/update (station work) but NOT delete.
    // Managers may do anything, including delete.
    match /units/{unitId} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isManager();
    }

    // ---- users (roles) ----
    // Anyone signed in can read (the app checks roles).
    // Managers can create/change/delete any role assignment.
    // A brand-new signed-in user may create ONLY their own doc and ONLY
    // as an unassigned worker — they cannot make themselves a manager,
    // and cannot touch anyone else's role.
    match /users/{userEmail} {
      allow read: if signedIn();
      allow create: if isManager()
        || ( signedIn()
             && userEmail == request.auth.token.email.lower()
             && request.resource.data.role == 'worker' );
      allow update, delete: if isManager();
    }

    // ---- announcements ----
    // Everyone signed in can read + acknowledge (update reads/acks).
    // Only managers can create or delete announcements.
    match /announcements/{annId} {
      allow read:   if signedIn();
      allow update: if signedIn();     // acknowledgements
      allow create, delete: if isManager();
    }

    // ---- issue reports (worker <-> manager messaging) ----
    // Everyone signed in can read, create, and reply (update).
    // Only managers can delete.
    match /issueReports/{issueId} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isManager();
    }

    // ---- station access (which employee IDs work which station) ----
    // Everyone signed in can read (the app checks access on scan).
    // Only managers can change who is authorized.
    match /stationAccess/{stationId} {
      allow read:  if signedIn();
      allow write: if isManager();
    }

    // ---- config (station list + monthly goals) ----
    // Everyone signed in can read.
    // Only managers can change configuration.
    match /config/{docId} {
      allow read:  if signedIn();
      allow write: if isManager();
    }

    // ---- error log ----
    // Any signed-in user can WRITE an error (so problems get recorded).
    // Only managers can READ them.
    match /errorLog/{errId} {
      allow create: if signedIn();
      allow read:   if isManager();
      allow update, delete: if isManager();
    }

    // ---- anything else: deny by default ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
